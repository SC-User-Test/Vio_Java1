# Cloud-Ready Application Configuration
# All values can be overridden by environment variables

# Database Configuration (AWS RDS)
DB_URL=jdbc:postgresql://localhost:5432/appdb
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONN_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=app-file-storage

# Application Configuration
ENVIRONMENT=development
PORT=8080
LOG_LEVEL=INFO

# Cloud Deployment Notes:
# - In AWS ECS/EKS, set these as environment variables in task definition
# - In AWS Elastic Beanstalk, set in environment properties
# - In AWS Lambda, set in function configuration
# - Use AWS Secrets Manager for sensitive values (DB_PASSWORD)
# - Use AWS Systems Manager Parameter Store for configuration
